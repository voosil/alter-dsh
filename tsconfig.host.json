{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "outDir": "lib",
    "rootDir": ".",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@alter/protocol": [
        "vendor/protocol/src/index.ts"
      ]
    }
  },
  "include": [
    "host/**/*.ts",
    "vendor/service/src/**/*.ts",
    "vendor/protocol/src/**/*.ts",
    "server/**/*.ts"
  ]
}
