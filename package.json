{
  "name": "@alter-dsh/space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-contained Space feature for the DSH Web client: SQLite-backed Host authority, browser RPC client, space directory, documents, thoughts, hub overview, activity, archive and configuration.",
  "exports": {
    ".": "./lib/host/core/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "scripts": {
    "build:client": "node build/build.mjs",
    "build:host": "node scripts/build/clean-lib.mjs && tsc -p tsconfig.host.json",
    "build": "node build/build.mjs && tsc -p tsconfig.host.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json --noEmit",
    "lint": "node scripts/gate/lint.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:nightly": "node scripts/gate/test-nightly.mjs",
    "test:coverage": "vitest run --coverage",
    "coverage:report": "node scripts/coverage/report.mjs",
    "verify": "node scripts/gate/verify.mjs",
    "docs:check": "node scripts/docs/check.mjs",
    "docs:archive": "node scripts/docs/archive.mjs",
    "check": "node scripts/gate/lint.mjs && node build/build.mjs && node scripts/build/clean-lib.mjs && tsc -p tsconfig.host.json && node scripts/gate/verify.mjs && node scripts/docs/archive.mjs && node scripts/docs/check.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.host.json --noEmit && vitest run",
    "server": "node lib/server/core/index.js",
    "migrate": "node scripts/ops/space-migrate.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-highlight": "^3.33.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-table-cell": "^3.33.0",
    "@tiptap/extension-table-header": "^3.33.0",
    "@tiptap/extension-table-row": "^3.33.0",
    "@tiptap/extension-task-item": "^3.33.0",
    "@tiptap/extension-task-list": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@types/node": "26.6.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^5.0.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^31.0.0",
    "lucide-react": "1.60.0",
    "oxlint": "^1.93.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "5.9.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "bin": {
    "alter-dsh-space-server": "./lib/server/core/index.js"
  },
  "packageManager": "pnpm@12.1.0"
}
